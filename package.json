{
  "name": "pi-agenthint",
  "version": "0.3.1",
  "description": "Agent Hint request metadata and lifecycle reporting for Pi",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Eric1481/pi-agenthint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eric1481/pi-agenthint.git"
  },
  "bugs": {
    "url": "https://github.com/Eric1481/pi-agenthint/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-hint",
    "provider",
    "request-headers",
    "observability",
    "scheduling"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/extension.js"
    ]
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/*.test.js\"",
    "test:e2e": "node --test \"test/e2e/*.test.js\"",
    "check": "npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0"
  }
}
